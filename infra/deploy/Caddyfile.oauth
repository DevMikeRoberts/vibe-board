# Edge proxy — auth_mode = "oauth".
#
# Same shape as Caddyfile.basic, except the login gate is oauth2-proxy against
# GitHub with an explicit user allowlist (OAUTH2_PROXY_GITHUB_USER). Every
# request is authorised by a subrequest to oauth2-proxy before it is proxied;
# unauthenticated visitors are bounced to the GitHub consent screen.
#
# {$VAR} values come from /opt/agentboard/.env, rendered from SSM by deploy.sh.
{
	email {$ACME_EMAIL}
	admin off
}

{$BOARD_DOMAIN} {
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}

	route {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			-Server
		}

		encode zstd gzip

		# The OAuth dance itself must stay reachable without a session.
		handle /oauth2/* {
			reverse_proxy oauth2-proxy:4180
		}

		# Gate for everything below. A 401 from oauth2-proxy turns into a
		# redirect to the sign-in flow, preserving the originally requested URL.
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			copy_headers X-Auth-Request-User X-Auth-Request-Email

			@unauthorized status 401
			handle_response @unauthorized {
				redir * /oauth2/start?rd={scheme}://{host}{uri}
			}
		}

		handle /ws* {
			rewrite * /ws?token={$API_KEY}
			reverse_proxy server:8080
		}

		handle /api/* {
			reverse_proxy server:8080 {
				header_up Authorization "Bearer {$API_KEY}"
				flush_interval -1
			}
		}

		handle {
			reverse_proxy web:80
		}
	}
}
